# One instance per remote-agent session (%i is the session name).
# `start` enables it and `cancel` disables it, so enabled sessions start again at boot.
[Unit]
Description=remote-agent Pi session %i

[Service]
Slice=agents.slice
ExecStart=%h/.local/bin/remote-agent __serve --state %h/.local/state/remote-agent/sessions/%i
StandardOutput=append:%h/.local/state/remote-agent/sessions/%i/server.log
StandardError=inherit
KillMode=control-group
# An OOM-killed tool process must not stop the session: the default `stop` kills Pi.
OOMPolicy=continue

[Install]
WantedBy=default.target
